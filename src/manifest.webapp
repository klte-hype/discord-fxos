{
  "version": "0.0.1",
  "name": "Discord WAP",
  "description": "Discord WAP for Firefox OS",
  "type": "privileged",
  "fullscreen": true,
  "launch_path": "/index.html",
  "csp": "default-src 'self'; script-src 'self'; connect-src 'self' http://wap.gtrxac.fi; frame-src http://wap.gtrxac.fi;",
  "developer": {
    "name": "klte_hype",
	"url":"https://github.com/klte-hype"
  },
  "default_locale": "en-US",
  "display":"browser",
  "locales": {
    "en-US": {
      "name":"Discord WAP"
	}
  },
  "icons": {
    "60": "/img/icon_60x60.png",
    "128": "/img/icon_128x128.png",
    "192": "/img/icon_hires.png"
  },
  "origin": "app://discordwap.local"
}
