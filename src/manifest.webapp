{
  "version": "0.1.0",
  "name": "Discord",
  "description": "A simple Firefox OS app for @gtrxAC's Discord WAP client",
  "type": "web",
  "fullscreen": true,
  "launch_path": "/index.html",
  "developer": {
    "name": "klte_hype",
	"url":"https://github.com/klte-hype"
  },
  "default_locale": "en-US",
  "display":"browser",
  "locales": {
    "en-US": {
      "name":"Discord"
	}
  },
  "icons": {
    "60": "/img/icon_60x60.png",
    "128": "/img/icon_128x128.png",
    "192": "/img/icon_hires.png"
  },
  "origin": "app://discordwap.local"
}
